# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# NOTE: the stock Python .gitignore lists ``lib/`` and ``lib64/`` here, meaning
# setuptools build output. This project keeps its own source in ``lib/`` (the
# LIB_* modules), so those two patterns are deliberately absent — they would
# exclude the whole library layer. Build output is already covered by ``build/``.
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

