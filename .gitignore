geojson-processed/

# Geodata: inputs, intermediates and outputs, not source. ~7 GB, nearly all of
# it one Canada120m.tif; the province GeoJSON in here is pipeline data that the
# UI_* tools read and write, so it churns constantly and does not belong in the
# history. Keep it backed up by other means — git is not that.
Data/
unused/

# Claude Code: the shared project settings are tracked, the per-machine ones
# (paths, one-off tool approvals) are not.
.claude/settings.local.json

# Temporary files
*.tmp
*.bak
